    "BaseUrl": "http://localhost:11434",
    "ApiKey": "",
    "ChatModel": "qwen2.5:14b",
    "EmbedModel": "nomic-embed-text",
    "EmbedBaseUrl": "",
    "EmbedApiKey": "",
    "EmbedDimension": 768,
    "TimeoutSeconds": 90,
    "Temperature": 0.2,
    "KeepAlive": "30m"
  },

  "Screening": {
    "_comment": "Who an applicant talks to after the screening questions, by work mode. Empty by default. Add entries as { WorkMode, Name, Url, Handles }. A URL that is not http(s) is dropped rather than rendered.",
