  },

  "Matching": {
    "MinSimilarity": 0.45,
    "CandidatePoolSize": 50,
    "TopN": 5,
    "ConversationalFilterThreshold": 8,
    "WeightSemantic": 0.50,
    "WeightSkillOverlap": 0.25,
    "WeightTitle": 0.15,
    "WeightExperience": 0.10,
    "SkillEquivalenceMin": 0.72,
    "SkillRelatedMin": 0.72
