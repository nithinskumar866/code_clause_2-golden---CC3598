# Copy to `.env` (same folder) and fill in. `.env` is gitignored.
#
# Keys use .NET's nesting convention: `Ollama__ApiKey` here is `Ollama:ApiKey` in
# configuration, and the same name works as a real environment variable in a
# container. A real environment variable always wins over this file.
#
# EVERY setting is optional. With none of them set the portal still runs:
#   - job and resume extraction fall back to the deterministic structure reader
#   - matching falls back to the deterministic embedder, which compares WORDING
#     rather than MEANING (a resume saying "React" will NOT surface for a posting
#     asking for a "modern frontend framework")
#   - chat replies are composed deterministically instead of written by a model
# The health endpoint reports which of these modes is active.

# --- Chat / reasoning model -------------------------------------------------
# Ollama Cloud:
#   Ollama__BaseUrl=https://ollama.com
#   Ollama__ApiKey=<your ollama cloud key>
#   Ollama__ChatModel=glm-5.2
# Self-hosted or RunPod (no key needed):
#   Ollama__BaseUrl=https://<host>
#   Ollama__ChatModel=llama3.1:8b
#
# Verify the tag your endpoint actually serves with `GET /api/health`, which
# lists them. A model id that does not exist there fails every call and the
# portal silently runs deterministic.
#
# NO /v1 SUFFIX. This client posts to the native api/chat; the Python platform
# points at the same host through its OpenAI-compatible surface and does need /v1.
#
# `GET /api/health` also reports availableModels — the fastest way to tell WHICH
# endpoint is really in force. A list that does not match the box you think you
# configured means something else filled the value first: appsettings.json wins
# over this file, because DotEnv only fills gaps.
#
# Ollama__KeepAlive: how long the endpoint holds the weights after a call ("30m").
# Leave it unset only if one model has the box to itself; otherwise every call pays
# the reload.
Ollama__BaseUrl=
Ollama__ApiKey=
Ollama__ChatModel=

# --- Embedding model --------------------------------------------------------
# This is what makes matching semantic. Set it separately from the chat endpoint
# when your chat host does not serve embedding models, which is common.
#
# EmbedDimension MUST match the model's real output width, or the portal rejects
# the vectors and falls back rather than searching a misaligned index:
#   nomic-embed-text  -> 768
#   mxbai-embed-large -> 1024
#   all-minilm        -> 384
Ollama__EmbedBaseUrl=
Ollama__EmbedApiKey=
Ollama__EmbedModel=
Ollama__EmbedDimension=768

Ollama__TimeoutSeconds=120
Ollama__Temperature=0.2

# --- Shared database --------------------------------------------------------
# Defaults to the Python platform's hiring_platform.db, which is what "shares the
# Python DB" means: one SQLite file, the portal's tables all prefixed `portal_`,
# the recruiter platform's tables read-only and never migrated from here.
# Point this somewhere else to run the portal standalone.
Portal__DatabasePath=
Portal__PythonStorageDir=
Portal__ResumeUploadDir=
