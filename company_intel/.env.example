# ---------------------------------------------------------------------------
# company_intel — configuration
# Qdrant is the ONLY datastore. Nothing here points at another database.
# ---------------------------------------------------------------------------

# --- Qdrant ---------------------------------------------------------------
QDRANT_URL=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=30
# Collection names. Change only before the first run — renaming later orphans data.
QDRANT_COMPANIES_COLLECTION=ci_companies
QDRANT_SOURCES_COLLECTION=ci_sources
QDRANT_CONTENT_COLLECTION=ci_content

# --- Embeddings -----------------------------------------------------------
# 'fastembed' = local ONNX, no key, no GPU, ~1.3 chunks/s on 4 cores.
# 'ollama'    = a remote GPU endpoint, measured ~24 chunks/s (18x faster).
# These are NOT interchangeable at runtime: they emit different dimensions, so
# changing provider means dropping the content collection and re-crawling.
EMBED_PROVIDER=ollama
EMBED_OLLAMA_URL=https://<your-pod>-11434.proxy.runpod.net
EMBED_OLLAMA_MODEL=nomic-embed-text
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=768
EMBED_BATCH=16
EMBED_TIMEOUT_SECONDS=120
EMBED_MAX_RETRIES=3
# Cosine floor for retrieval; below it the answerer says it does not know rather
# than improvising over weak evidence. Leave at 0 to use the floor calibrated for
# the configured model (bge 0.55, nomic 0.62) — the right value differs per model,
# and a bge floor on nomic lets off-topic questions through.
EMBED_MIN_SIMILARITY=0

# --- Crawler --------------------------------------------------------------
CRAWL_USER_AGENT=company-intel-bot/0.1 (+contact: set-me@example.com)
CRAWL_TIMEOUT_SECONDS=15
CRAWL_MAX_PAGES=60
CRAWL_MAX_DEPTH=3
CRAWL_CONCURRENCY_PER_HOST=2
CRAWL_DEFAULT_DELAY_SECONDS=1.0
CRAWL_MAX_RETRIES=3
CRAWL_MAX_BYTES=3000000
# Consecutive failures before a URL is retired from the refresh schedule.
CRAWL_MAX_FAILURES=5
CRAWL_RESPECT_ROBOTS=true

# --- Chunking -------------------------------------------------------------
CHUNK_TARGET_CHARS=1800
CHUNK_OVERLAP_CHARS=240
CHUNK_MIN_CHARS=200

# --- Refresh cadence (days, per page_type) --------------------------------
REFRESH_DAYS_NEWS=2
REFRESH_DAYS_PRODUCTS=14
REFRESH_DAYS_ABOUT=30
REFRESH_DAYS_DEFAULT=30
REFRESH_BATCH=50

# --- Answering ------------------------------------------------------------
# 'none' quotes the retrieved passages directly; 'ollama' / 'openai' phrase them.
# Unlike the embedding provider this IS a safe fallback: an unreachable model
# costs readability, never accuracy, because retrieval fixes the facts first.
ANSWER_PROVIDER=ollama
ANSWER_OLLAMA_URL=https://<your-pod>-11434.proxy.runpod.net
ANSWER_MODEL=llama3.1:8b
ANSWER_TIMEOUT_SECONDS=180
OPENAI_API_KEY=
ANSWER_MAX_CONTEXT_CHUNKS=8
