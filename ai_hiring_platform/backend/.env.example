# Copy this file to .env and fill in the values. Every setting is optional —
# with no LLM key configured the platform runs fully on the deterministic engine.

# --- LLM reasoning (provider-agnostic) --------------------------------------
# Provider: openai | anthropic | google  (aliases: gemini->google, claude->anthropic)
# To use Gemini for reasoning, set:  LLM_PROVIDER=google  and  GOOGLE_API_KEY=<key>
LLM_PROVIDER=openai
# Explicit model id; leave blank for the per-provider default
# (openai=gpt-4o-mini, anthropic=claude-sonnet-5, google=gemini-2.0-flash).
# Recommended Gemini: gemini-2.0-flash (fast + cheap) or gemini-1.5-pro (max quality).
LLM_MODEL=

# API keys — set only the one matching LLM_PROVIDER. Leave all blank to run the
# deterministic reasoning engine (no network, full report still produced). A wrong
# key or an unsupported model also falls back to the deterministic engine.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# GEMINI_API_KEY is also accepted as an alias for GOOGLE_API_KEY.

# --- Persistence ------------------------------------------------------------
DATABASE_URL=sqlite:///./hiring_platform.db

# --- Retrieval tuning (optional; sensible defaults shown) --------------------
RETRIEVAL_MIN_SIMILARITY=0.30
# Hybrid retrieval: fuse dense (vector) + sparse (BM25) via Reciprocal Rank Fusion.
HYBRID_RETRIEVAL_ENABLED=true
HYBRID_WEIGHT_DENSE=0.6
HYBRID_WEIGHT_SPARSE=0.4
HYBRID_RRF_K=60
# Sentence-aware chunking.
CHUNK_TARGET_CHARS=350
CHUNK_MAX_CHARS=600
CHUNK_SENTENCE_OVERLAP=1

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO

# --- Self-hosted / OpenAI-compatible endpoint (optional) --------------------
# Point the platform at any OpenAI-compatible /chat/completions server — Ollama,
# vLLM, LM Studio, LocalAI, a RunPod proxy. When LLM_BASE_URL is set it takes
# precedence over LLM_PROVIDER above, and no API key is needed for a local model.
#   LLM_BASE_URL=https://<host>/v1
#   LLM_MODEL=llama3.1:8b
#   LLM_API_KEY=            # only if your endpoint requires a bearer token
#   LLM_TIMEOUT_SECONDS=120

# --- Embedding engine (dual: local CPU + optional GPU) ----------------------
# 'bge' = local BAAI/bge-large-en-v1.5, in-process, 1024 dims. Default; never fails.
# 'gpu' = a model served from your own Ollama-compatible endpoint, e.g.
#         nomic-embed-text (768 dims). Sharper retrieval, adds a network hop.
# Each engine keeps its OWN index (storage/vectors/corpus-<engine>/) because vectors
# from different models are not comparable. Selecting 'gpu' while the endpoint is
# down serves the local index and reports the fallback. Revert with EMBEDDING_ENGINE=bge.
#   EMBEDDING_ENGINE=bge
#   EMBEDDING_GPU_URL=https://<your-host>
#   EMBEDDING_GPU_MODEL=nomic-embed-text
#   EMBEDDING_GPU_DIM=768
#   EMBEDDING_GPU_MIN_SIMILARITY=0.51   # calibrate per model; see README
#   EMBEDDING_GPU_TIMEOUT_SECONDS=60
#   EMBEDDING_GPU_BATCH=32

# --- mxbai-embed-large-v1 (third engine, local CPU, 1024 dims) --------------
# Runs in-process via FastEmbed/ONNX exactly like BGE — no GPU, no endpoint, so it can
# always index even when the remote model is down. That matters for a fair comparison:
# a model that cannot index cannot be compared on the same resumes.
#
# The floor is calibrated to EQUAL SELECTIVITY with BGE (0.537 admits the same fraction
# of query-chunk pairs that BGE admits at 0.62, measured over 279 chunks of real
# resumes). Cosine values are not comparable across models, so a shared threshold would
# reward whichever model scores higher in absolute terms rather than the one that ranks
# better.
EMBEDDING_MXBAI_MIN_SIMILARITY=0.537
# 8, not FastEmbed's default 256: a 335M-parameter model at 512 tokens asked ONNX
# Runtime for a 1.15 GB buffer and died. Throughput is flat from 8 to 64 anyway
# (~1.9 chunks/s on CPU), so budget ~45 min to index 600 resumes the first time.
EMBEDDING_MXBAI_BATCH=8

# ---------------------------------------------------------------------------
# Self-hosted reasoning runtimes — Ollama now, RunPod when the GPU lands.
# ---------------------------------------------------------------------------
# Both are configured at once and picked by name, so moving between them is one
# env var and no redeploy.
#   LLM_RUNTIME=auto    prefer RunPod, else Ollama, else the hosted provider
#   LLM_RUNTIME=ollama  force the local daemon
#   LLM_RUNTIME=runpod  force the GPU box
#   LLM_RUNTIME=api     ignore both and use LLM_PROVIDER above
# An EXPLICIT choice never silently falls through to the other one: a benchmark
# that quietly ran on the wrong runtime is worse than one that fails.
LLM_RUNTIME=auto
OLLAMA_BASE_URL=http://localhost:11434
# Blank means "no Ollama" — set a model id to switch it on, e.g. llama3.1:8b
OLLAMA_MODEL=
RUNPOD_BASE_URL=
RUNPOD_MODEL=
RUNPOD_API_KEY=

# ---------------------------------------------------------------------------
# LLM-assisted retrieval (services/ai/chat_llm_retrieval.py)
# ---------------------------------------------------------------------------
# A third stage on top of dense + sparse. Both default OFF: with them off the
# retrieval funnel behaves exactly as it always has, and they degrade back to it
# on any failure, timeout or malformed reply.
#
# VERIFY  the model judges whether a retrieved passage really evidences a skill,
#         instead of the lexical word-presence rule. Fixes both directions:
#         "ran sprint ceremonies" DOES evidence Communication; "worked alongside
#         the Java team" does NOT evidence Java.
# RERANK  the top K deterministic results are re-scored against the question and
#         the judgement enters the score as one more weighted, visible parameter.
RETRIEVAL_LLM_VERIFY_ENABLED=false
RETRIEVAL_LLM_RERANK_ENABLED=false
RETRIEVAL_LLM_RERANK_TOP_K=50
# Share of the final score the model's judgement carries, before renormalising
# against the parameters the recruiter actually asked for.
MATCH_WEIGHT_LLM_RELEVANCE=0.18
# Batches run CONCURRENTLY. The .NET portal shipped a sequential per-item loop
# and it cost ~13 serial round trips per turn — do not repeat that here.
RETRIEVAL_LLM_CONCURRENCY=8
RETRIEVAL_LLM_BATCH=8
# Hard ceiling for the whole assisted stage. On expiry, whatever came back is
# used and everything else keeps its deterministic treatment.
RETRIEVAL_LLM_DEADLINE_SECONDS=20
RETRIEVAL_LLM_CACHE_SIZE=4096

# ---------------------------------------------------------------------------
# Company intelligence module (services/company/*) — OPTIONAL
# ---------------------------------------------------------------------------
# A separate knowledge base of employer records, held in Qdrant Cloud and reached only
# when the chat UI is toggled into company mode. Leave these blank and the platform
# behaves exactly as it always has; the toggle simply stays disabled.
#
# The collection's vector size is fixed at creation to EMBEDDING_GPU_DIM, so this module
# uses the GPU engine and NEVER falls back to a local one — a 384-dim vector written
# into a 768-dim collection is either rejected or silently meaningless.
#
# Load data with:  python -m scripts.load_companies <file.xlsx>
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COMPANIES_COLLECTION=companies
QDRANT_TIMEOUT_SECONDS=30
# Cosine floor for company retrieval. Separate from the resume floors because company
# prose is short, dense and written in marketing register — a different distribution.
COMPANY_MIN_SIMILARITY=0.45
COMPANY_TOP_K=24
