# Copy to .env (or .env.local) to point the SPA at a non-default backend.
# Defaults to http://localhost:8000 when unset. Must include scheme + host
# (the client appends /api/v1 itself). Example for a deployed backend:
# VITE_API_BASE=https://hiring-api.example.com
VITE_API_BASE=http://localhost:8000

# The .NET job-portal API that backs the Job Board, Post a Job and the career
# assistant popup. Separate from VITE_API_BASE because it is a separate process
# on a separate port, and either can be deployed without the other.
# Defaults to http://localhost:5290 when unset.
VITE_PORTAL_API_BASE=http://localhost:5290
